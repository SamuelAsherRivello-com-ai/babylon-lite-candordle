{
  "name": "wordle-clone",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:dictionary": "tsx scripts/generate-five-letter-words.ts",
    "prebuild": "npm run generate:dictionary",
    "dev": "vite",
    "build": "npm run check:typescript-source && npm run typecheck && npm test && vite build && node --experimental-strip-types scripts/check-deployment-assets.ts",
    "preview": "vite preview",
    "test": "node --import tsx --test --test-isolation=none wordle-clone/test/game.test.ts",
    "test:browser": "playwright test",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "check:typescript-source": "tsx scripts/check-typescript-source.ts"
  },
  "dependencies": {
    "@babylonjs/lite": "1.32.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@webgpu/types": "0.1.71",
    "an-array-of-english-words": "^2.0.0",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vite": "^8.3.0"
  }
}
